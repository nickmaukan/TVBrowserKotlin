<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#121212</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_surface">#FFFFFF</color>
    <color name="on_surface_variant">#B3B3B3</color>
    <color name="primary">#6200EE</color>
    <color name="primary_variant">#3700B3</color>
    <color name="secondary">#03DAC6</color>
    <color name="surface">#1E1E1E</color>
    <style name="Theme.TVBrowser" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorForeground">@color/on_surface</item>
    </style>
    <style name="Theme.TVBrowser.Fullscreen" parent="@style/Theme.TVBrowser">
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>